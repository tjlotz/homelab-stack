# ==============================================================================
# BLACKBOX — homelab-stack environment configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# ==============================================================================

# --- System ---
TZ=America/New_York
PUID=1000
PGID=1000

# --- Host ---
HOST_IP=192.168.1.2

# --- Plex ---
# Get a claim token at https://www.plex.tv/claim (expires in 4 minutes)
PLEX_CLAIM=

# --- Pi-hole ---
PIHOLE_PASSWORD=

# --- NAS (WD MyCloud) ---
NAS_CAMERAS_USER=admin
NAS_CAMERAS_PASS=

# --- Reolink Cameras ---
# Credentials used by both Frigate (go2rtc) and Home Assistant Reolink integration
#
# Doorbell D340B — 192.168.1.10 (connects via P2P using UID, no open ports)
REOLINK_DOORBELL_USER=admin
REOLINK_DOORBELL_PASS=
REOLINK_DOORBELL_UID=
#
# E1 Zoom (Garage) — 192.168.1.11 (connects via port 9000)
REOLINK_GARAGE_USER=admin
REOLINK_GARAGE_PASS=
#
# E1 Zoom (Living Room) — 192.168.1.12 (connects via port 9000)
REOLINK_LIVING_ROOM_USER=admin
REOLINK_LIVING_ROOM_PASS=
