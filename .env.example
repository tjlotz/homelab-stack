# ==============================================================================
# BLACKBOX — homelab-stack environment configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# ==============================================================================

# --- System ---
TZ=America/New_York
PUID=1000
PGID=1000

# --- Host ---
HOST_IP=192.168.1.2

# --- Plex ---
# Get a claim token at https://www.plex.tv/claim (expires in 4 minutes)
PLEX_CLAIM=

# --- Pi-hole ---
PIHOLE_PASSWORD=

# --- NAS (WD MyCloud) ---
NAS_CAMERAS_USER=admin
NAS_CAMERAS_PASS=

# --- Reolink Cameras ---
# Camera credentials are managed via Home Assistant's Reolink integration (web UI).
# See README.md for setup instructions.
#
# Camera IPs:
#   Doorbell D340B  — 192.168.1.10 (Reolink app only — no local API, see Issue #6)
#   E1 Zoom Garage  — 192.168.1.11 (Baichuan port 9000)
#   E1 Zoom Living  — 192.168.1.12 (Baichuan port 9000)
