# ==============================================================================
# BLACKBOX — homelab-stack environment configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# Lock down with: chmod 600 .env
# ==============================================================================

# --- System ---
TZ=America/New_York
PUID=1000
PGID=1000

# --- Host ---
HOST_IP=192.168.1.2

# --- Plex ---
# Get a claim token at https://www.plex.tv/claim (expires in 4 minutes)
PLEX_CLAIM=

# --- Pi-hole ---
PIHOLE_PASSWORD=

# --- NAS (WD MyCloud) ---
NAS_CAMERAS_USER=admin
NAS_CAMERAS_PASS=

# --- Reolink Cameras (RTSP) ---
# Single shared admin user + password across all cameras for setup simplicity.
# Use a 20+ char alphanumeric password and store in a password manager.
# Set this same password on each camera via the Reolink app.
REOLINK_USER=admin
REOLINK_PASS=

# Camera IPs:
#   .10  Doorbell    (Reolink D340W, wired, RTSP)
#   .11  Garage      (Reolink E1 Pro, RTSP)
#   .12  Living Room (Reolink E1 Pro, RTSP)
#   .13  Office      (Reolink E1 Pro, RTSP)
#   .14  Driveway    (Reolink Lumus Pro E450, RTSP)

# --- MQTT (Mosquitto) ---
# Used by Frigate <-> HA. setup.sh hashes this into mosquitto/config/passwd.
MQTT_USER=admin
MQTT_PASS=
