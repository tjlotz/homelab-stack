# ==============================================================================
# BLACKBOX — homelab-stack environment configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# ==============================================================================

# --- System ---
TZ=America/New_York
PUID=1000
PGID=1000

# --- Host ---
HOST_IP=192.168.1.2

# --- Plex ---
# Get a claim token at https://www.plex.tv/claim (expires in 4 minutes)
PLEX_CLAIM=

# --- Pi-hole ---
PIHOLE_PASSWORD=

# --- NAS (WD MyCloud) ---
NAS_CAMERAS_USER=admin
NAS_CAMERAS_PASS=

# --- Cameras (Reolink RTSP passwords) ---
# Doorbell D340B — 192.168.1.10
FRIGATE_DOORBELL_PASS=
# E1 Zoom (Garage) — 192.168.1.11
FRIGATE_GARAGE_PASS=
# E1 Zoom (Living Room) — 192.168.1.12
FRIGATE_LIVING_ROOM_PASS=
